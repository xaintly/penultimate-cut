<?xml version="1.0" encoding="utf-8"?>
<!--
  The Microsoft Store package's description. scripts/build_msix.ps1 fills in
  {Version} (pyproject.toml's version as four parts, the last always 0, as
  the Store requires) and packs it with the PyInstaller build.

  Identity and PublisherDisplayName must match Partner Center exactly
  (Product management > Product identity); the Store rejects anything else.
  It signs the package itself, so nothing here is signed.

  runFullTrust: an ordinary desktop app, not a sandboxed one. Partner Center
  asks for a sentence on why; see packaging/msix/README.md.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="Xaintly.PenultimateCut"
    Publisher="CN=9059FC2E-B236-4474-B702-A62B7955650B"
    Version="{Version}"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Penultimate Cut</DisplayName>
    <PublisherDisplayName>Xaintly</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>A simple video editor</Description>
  </Properties>

  <!-- Windows 10 1809 is the oldest Qt 6 runs on. -->
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="PenultimateCut" Executable="PenultimateCut.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Penultimate Cut"
        Description="A simple video editor"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
